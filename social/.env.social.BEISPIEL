# DDD-Social — Zugangsdaten. Diese Datei als „.env.social" (ohne .BEISPIEL) daneben kopieren
# und ausfüllen. .env.social steht in .gitignore und wird NIE committet.
# Leere Zeile = Plattform wird sauber übersprungen („übersprungen: Zugangsdaten fehlen").
# Welche Werte wo herkommen: ANLEITUNG_ZUGAENGE.md

# ── Bluesky ── (Handle z. B. dasdenktdeutschland.bsky.social; App-Passwort, NICHT das Konto-Passwort)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORT=
# optional, nur bei eigenem Server:
BLUESKY_PDS=

# ── X ── (OAuth 1.0a User Context, vier Werte aus der X Developer Console)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# „ja" = nur Text ohne Bild posten
X_OHNE_BILD=

# ── Facebook-Seite ──
FB_PAGE_ID=
FB_PAGE_TOKEN=
# optional, Standard v26.0:
FB_GRAPH_VERSION=

# ── Instagram (Reels) ──
IG_USER_ID=
IG_TOKEN=
# graph.facebook.com (Facebook-Login) oder graph.instagram.com (Instagram-Login); Standard graph.facebook.com
IG_API_HOST=
IG_GRAPH_VERSION=
# Instagram holt das Video selbst ab → öffentlicher Supabase-Storage-Eimer + Service-Schlüssel
DDD_MEDIEN_EIMER=
SUPABASE_SERVICE_ROLE_KEY=

# ── TikTok ── (Content Posting API, Direct Post)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# SELF_ONLY (Standard, Pflicht ohne Audit) oder nach Audit PUBLIC_TO_EVERYONE
TIKTOK_SICHTBARKEIT=

# ── Optional ──
# Claude-Schlüssel für die Texte; leer = wird aus vorhandenen Projekt-.env-Dateien gelesen
ANTHROPIC_API_KEY=
# öffentlicher Lesezugang der Seite; leer = wird aus dem ausgelieferten Seitenbündel gelesen
DDD_SUPABASE_ANON_KEY=
